{
  "name": "@yujyf/dsh-remote-workspace",
  "version": "0.1.0",
  "description": "Local/WSL remote-workspace execution routing for DeepSeek Harness: a profile bundle plus the sidebar workspace selector",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fs": {
      "types": "./lib/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./subprocess": {
      "types": "./lib/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    },
    "./controller": {
      "types": "./lib/controller.d.ts",
      "default": "./lib/controller.js"
    },
    "./ui": {
      "types": "./lib/ui.d.ts",
      "default": "./lib/ui.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-brand": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-store": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-fs": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-fs-local": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-fs-sandbox": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-sandbox": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-storage": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-subprocess": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-subprocess-local": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0 <0.2",
    "@deepseek-ai/schemastery": ">=3",
    "react": ">=18",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-fs": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-alpha.2",
    "@deepseek-ai/schemastery": "^3",
    "@types/node": "^22",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "~5.7.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
