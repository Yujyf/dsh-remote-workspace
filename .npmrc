# The DSH packages publish prerelease versions (0.1.2-rc.1, 0.1.5-alpha.2), which
# never satisfy their own `>=0.1.2` peer ranges. This package consumes them at
# runtime through the host profile, so development installs must not try to
# resolve or auto-install them.
auto-install-peers=false
strict-peer-dependencies=false
# The newest DSH release line is published days before development starts; the
# supply-chain age policy is a consumer-installation guard, not a build input.
minimumReleaseAge=0
